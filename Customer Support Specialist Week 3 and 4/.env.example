# Copy to .env and fill in your key. .env is gitignored — never commit real keys.
# Get a key at https://console.anthropic.com/ (the LLM rationale layer needs it;
# the rule-based scorer, batch job, and evaluation all run without it).
ANTHROPIC_API_KEY=

# Optional: override the default model used for rationale generation.
# ANTHROPIC_MODEL=claude-sonnet-5
